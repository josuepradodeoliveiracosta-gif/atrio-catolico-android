          || kind.matches('(?:🇧(?:🇯|🇱|🇲|🇳|🇴|🇶|🇷|🇸|🇹|🇻|🇼|🇾|🇿)|🇨(?:🇦|🇨|🇩|🇫|🇬|🇭|🇮|🇰|🇱|🇲|🇳|🇴|🇵|🇶|🇷|🇺|🇻|🇼|🇽|🇾|🇿)|🇩(?:🇪|🇬|🇯|🇰|🇲|🇴|🇿)|🇪(?:🇦|🇨|🇪|🇬|🇭|🇷|🇸|🇹|🇺)|🇫(?:🇮|🇯|🇰|🇲|🇴|🇷)|🇬(?:🇦|🇧|🇩|🇪|🇫|🇬|🇭|🇮|🇱|🇲|🇳|🇵|🇶|🇷|🇸|🇹|🇺|🇼|🇾)|🇭(?:🇰|🇲|🇳|🇷|🇹|🇺)|🇮(?:🇨|🇩|🇪|🇱|🇲|🇳|🇴|🇶|🇷|🇸|🇹)|🇯(?:🇪|🇲|🇴|🇵)|🇰(?:🇪|🇬|🇭|🇮|🇲|🇳|🇵|🇷|🇼|🇾|🇿)|🇱(?:🇦|🇧|🇨|🇮|🇰|🇷|🇸|🇹|🇺|🇻|🇾)|🇲(?:🇦|🇨|🇩|🇪|🇫|🇬|🇭|🇰|🇱|🇲|🇳|🇴|🇵|🇶|🇷|🇸|🇹|🇺|🇻|🇼|🇽|🇾|🇿)|🇳(?:🇦|🇨|🇪|🇫|🇬|🇮|🇱|🇴|🇵|🇷|🇺|🇿)|🇴🇲|🇵(?:🇦|🇪|🇫|🇬|🇭|🇰|🇱|🇲|🇳|🇷|🇸|🇹|🇼|🇾)|🇶🇦|🇷(?:🇪|🇴|🇸|🇺|🇼)|🇸(?:🇦|🇧|🇨|🇩|🇪|🇬|🇭|🇮|🇯|🇰|🇱|🇲|🇳|🇴|🇷|🇸|🇹|🇻|🇽|🇾|🇿)|🇹(?:🇦|🇨|🇩|🇫|🇬|🇭|🇯|🇰|🇱|🇲|🇳|🇴|🇷|🇹|🇻|🇼|🇿)|🇺(?:🇦|🇬|🇲|🇳|🇸|🇾|🇿)|🇻(?:🇦|🇨|🇪|🇬|🇮|🇳|🇺)|🇼(?:🇫|🇸)|🇽🇰|🇾(?:🇪|🇹)|🇿(?:🇦|🇲|🇼)|🏴󠁧󠁢(?:󠁥󠁮󠁧󠁿|󠁳󠁣󠁴󠁿|󠁷󠁬󠁳󠁿))'))));
    }
    // END GENERATED REACTION EMOJI ALLOWLIST

    function validText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function validId(value) {
      return validText(value, 1, 128) && !value.matches('.*[/].*');
    }
    // A decisão de uma resposta não pode apagar nem alterar a publicação principal.
    function reportParentUnchanged() {
      let path = /databases/$(database)/documents/posts/$(resource.data.postId);
      return (exists(path) && existsAfter(path) && get(path).data == getAfter(path).data)
        || (!exists(path) && !existsAfter(path));
    }
    function reportTargetRemoved() {
      return resource.data.keys().hasAny(['replyId'])
        ? (exists(/databases/$(database)/documents/posts/$(resource.data.postId)/replies/$(resource.data.replyId))
          && !existsAfter(/databases/$(database)/documents/posts/$(resource.data.postId)/replies/$(resource.data.replyId))
          && reportParentUnchanged())
        : !existsAfter(/databases/$(database)/documents/posts/$(resource.data.postId));
    }
    function validReviewTarget() {
      // Clientes antigos não podem tratar denúncia de resposta como publicação.
      return resource.data.keys().hasAny(['replyId'])
        ? request.resource.data.get('reviewTarget', '') == 'reply'
        : request.resource.data.get('reviewTarget', 'post') == 'post';
    }
    function validTime() {
      return request.resource.data.createdAt == request.time;
    }
    function publicNameMatchesProfile() {
      return request.resource.data.authorName ==
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName;
    }
    function validCategory(category) {
      return category in [
        'Sagradas Escrituras', 'Apologética', 'Vida espiritual',
        'História da Igreja', 'Liturgia', 'Santos',
        'Juventude', 'Pedidos de oração'
      ];
    }

    // Atribuição de clero e aprovação devem ocorrer no mesmo batch.
    // Verificamos estados ANTES e DEPOIS, nunca apenas flags da interface.
    function approvedClergyGrant(uid, clergy) {
      let requestPath = /databases/$(database)/documents/badge_requests/$(uid);
      return isAdmin()
        && request.auth.uid != uid
        && exists(requestPath)
        && get(requestPath).data.status == 'pending'
        && get(requestPath).data.kind == clergy
        && getAfter(requestPath).data.status == 'approved'
        && getAfter(requestPath).data.reviewedBy == request.auth.uid;
    }
    function approvedRequestHasGrant(uid) {
      let badgePath = /databases/$(database)/documents/badges/$(uid);
      return existsAfter(badgePath)
        && getAfter(badgePath).data.clergy == resource.data.kind
        && (!exists(badgePath)
          || get(badgePath).data.get('clergy', '') != resource.data.kind);
    }

    // Identificação leiga é autodeclarada; selo clerical exige admin e batch.
    match /badges/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if (me(uid)
        && request.resource.data.keys().hasOnly(['lay'])
        && request.resource.data.keys().hasAll(['lay'])
        && request.resource.data.lay in ['leigo', 'leiga'])
        || (approvedClergyGrant(uid, request.resource.data.get('clergy', ''))
          && request.resource.data.keys().hasOnly(['clergy'])
          && request.resource.data.clergy in ['padre', 'diacono']);
      allow update: if (me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lay'])
        && request.resource.data.keys().hasAll(['lay'])
        && request.resource.data.lay in ['leigo', 'leiga', ''])
        || (approvedClergyGrant(uid, request.resource.data.get('clergy', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clergy'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['clergy'])
          && request.resource.data.clergy in ['padre', 'diacono']);
      allow delete: if false;
    }

    // Os pedidos são privados para terceiros e consultáveis por admins ativos.
    // Rejeitar altera só o pedido; aprovar exige gravar o selo no mesmo batch.
    match /badge_requests/{uid} {
      allow get: if me(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['kind', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'status', 'createdAt'])
        && request.resource.data.kind in ['padre', 'diacono']
        && request.resource.data.status == 'pending'
        && validTime();
      allow update: if (me(uid)
        && resource.data.status in ['rejected', 'dismissed']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['kind', 'status', 'createdAt'])
        && request.resource.data.kind in ['padre', 'diacono']
        && request.resource.data.status == 'pending'
        && validTime())
        || (isAdmin()
          && request.auth.uid != uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
          && request.resource.data.keys().hasAll([
              'status', 'reviewedBy', 'reviewedAt', 'reviewNote'
            ])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && validText(request.resource.data.reviewNote, 10, 300)
          && (request.resource.data.status == 'rejected'
              || approvedRequestHasGrant(uid)));
      allow delete: if false;
    }

    match /profiles/{uid} {
      // Os perfis não podem ser enumerados, apenas lidos pelo proprietário.
      allow get: if me(uid);
      allow list: if false;
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && validText(request.resource.data.displayName, 2, 35)
        && validTime();
      allow update: if me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio'])
        && validText(request.resource.data.displayName, 2, 35)
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 180;
      allow delete: if false;
    }

    // Projeção pública voluntária: nunca conceder acesso de terceiros a /profiles.
    // A biografia só chega aqui após opt-in pelo titular da conta.
    match /public_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if me(uid)
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && validText(request.resource.data.displayName, 2, 35)
        && request.resource.data.displayName ==
          get(/databases/$(database)/documents/profiles/$(uid)).data.displayName
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && request.resource.data.bio ==
          get(/databases/$(database)/documents/profiles/$(uid)).data.get('bio', '')
        && request.resource.data.joinedAt ==
          get(/databases/$(database)/documents/profiles/$(uid)).data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if me(uid);
    }

    match /posts/{postId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'authorName', 'title', 'body', 'category', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'authorName', 'title', 'body', 'category', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && publicNameMatchesProfile()
        && validText(request.resource.data.title, 5, 120)
        && validText(request.resource.data.body, 5, 1200)
        && validCategory(request.resource.data.category)
        && validTime();
      // Somente o criador pode mudar título e texto: identidade, categoria e data são imutáveis.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body'])
        && validText(request.resource.data.title, 5, 120)
        && validText(request.resource.data.body, 5, 1200);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow get, list: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly([
            'uid', 'authorName', 'body', 'createdAt', 'replyToId', 'replyToUid',
            'mentionUid', 'mentionReplyId'
          ])
          && request.resource.data.keys().hasAll([
            'uid', 'authorName', 'body', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && publicNameMatchesProfile()
          && validText(request.resource.data.body, 1, 600)
          && validTime()
          // Alvo obtido da resposta existente, nunca pela string @nome.
          && (request.resource.data.keys().hasAny(['replyToId', 'replyToUid'])
            ? (request.resource.data.keys().hasAll(['replyToId', 'replyToUid'])
              && !request.resource.data.keys().hasAny(['mentionUid', 'mentionReplyId'])
              && validId(request.resource.data.replyToId)
              && validId(request.resource.data.replyToUid)
              && exists(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.replyToId))
              && get(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.replyToId)).data.uid == request.resource.data.replyToUid)
            : true)
          // Uma única menção explícita por resposta, somente a um membro
          // canônico que já participa desta discussão.
          && (request.resource.data.keys().hasAny(['mentionUid', 'mentionReplyId'])
            ? (request.resource.data.keys().hasAll(['mentionUid'])
              && !request.resource.data.keys().hasAny(['replyToId', 'replyToUid'])
              && validId(request.resource.data.mentionUid)
              && request.resource.data.mentionUid != request.auth.uid
              && (request.resource.data.keys().hasAny(['mentionReplyId'])
                ? (validId(request.resource.data.mentionReplyId)
                  && exists(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.mentionReplyId))
                  && get(/databases/$(database)/documents/posts/$(postId)/replies/$(request.resource.data.mentionReplyId)).data.uid == request.resource.data.mentionUid)
                : get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.resource.data.mentionUid))
            : true);
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

        match /reactions/{uid} {
          allow get, list: if signedIn();
          allow create: if me(uid)
            && exists(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId))
            && request.resource.data.keys().hasOnly(['kind', 'createdAt'])
            && request.resource.data.keys().hasAll(['kind', 'createdAt'])
            && validReactionKind(request.resource.data.kind)
            && request.resource.data.createdAt == request.time;
          allow update: if me(uid)
            && exists(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind'])
            && validReactionKind(request.resource.data.kind);
          allow delete: if me(uid);
        }
      }
    }

    match /users/{uid}/likedPosts/{postId} {
      allow get, list: if me(uid);
      allow create: if me(uid)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && validTime();
      allow delete: if me(uid);
      allow update: if false;
    }

    match /users/{uid}/savedPosts/{postId} {
      allow get, list: if me(uid);
      allow create: if me(uid)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && validTime();
      allow delete: if me(uid);
      allow update: if false;
    }

    // Acompanhamento persistente: somente o próprio usuário pode editar.
    match /users/{uid}/followedPosts/{postId} {
      allow get, list: if me(uid);
      allow create: if me(uid)
        && validId(postId)
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && validTime();
      allow delete: if me(uid);
      allow update: if false;
    }

    // Tokens de destino FCM privados por conta e dispositivo.
    // NENHUM cliente pode enviar mensagens FCM ou listar tokens alheios.
    // O envio exige backend de confianca com credenciais fora do aplicativo.
    match /users/{uid}/pushDevices/{deviceId} {
      allow get, list: if me(uid);
      allow create, update: if me(uid)
        && validId(deviceId)
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.keys().hasAll(['token', 'updatedAt'])
        && validText(request.resource.data.token, 20, 4096)
        && request.resource.data.updatedAt == request.time;
      allow delete: if me(uid);
    }

    match /users/{recipientUid}/notifications/{notificationId} {
      // Resposta direta: o destinatário é o autor canônico da resposta citada.
      // Requer criação da nova resposta no MESMO batch.
      function canonicalDirectRecipient() {
        let currentPath = /databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(notificationId);
        let targetId = request.resource.data.get('replyToId', '');
        return validId(targetId)
          && existsAfter(currentPath)
          && getAfter(currentPath).data.get('replyToId', '') == targetId
          && getAfter(currentPath).data.get('replyToUid', '') == recipientUid
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(targetId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(targetId)).data.uid == recipientUid;
      }
      // Menção explícita, validada contra a publicação ou resposta
      // de participante já existente (sem permitir buscar perfis privados).
      function canonicalMentionRecipient() {
        let currentPath = /databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(notificationId);
        let sourceId = request.resource.data.get('mentionReplyId', '');
        return existsAfter(currentPath)
          && getAfter(currentPath).data.get('mentionUid', '') == recipientUid
          && request.resource.data.get('mentionUid', '') == recipientUid
          && getAfter(currentPath).data.get('mentionReplyId', '') == sourceId
          && (sourceId == ''
            ? get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == recipientUid
            : (validId(sourceId)
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(sourceId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(sourceId)).data.uid == recipientUid));
      }
      // Somente o destinatário consulta, marca como lida ou dispensa notificações.
      allow get, list: if me(recipientUid);
      // O remetente não pode inventar notificações: a resposta relacionada
      // precisa nascer no mesmo batch, pertencer a ele e ter data atual.
      allow create: if signedIn()
        && request.auth.uid != recipientUid
        && request.resource.data.keys().hasOnly([
          'postId', 'replyId', 'actorUid', 'actorName', 'read', 'createdAt', 'replyToId',
          'mentionUid', 'mentionReplyId'
        ])
        && request.resource.data.keys().hasAll([
          'postId', 'replyId', 'actorUid', 'actorName', 'read', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.read == false
        && notificationId == request.resource.data.replyId
        && validText(request.resource.data.postId, 1, 128)
        && validText(request.resource.data.replyId, 1, 128)
        && request.resource.data.actorName ==
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && validTime()
        && (
          (get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == recipientUid
            && !request.resource.data.keys().hasAny(['replyToId', 'mentionUid', 'mentionReplyId']))
          || (request.resource.data.keys().hasAny(['replyToId'])
              && !request.resource.data.keys().hasAny(['mentionUid', 'mentionReplyId'])
              && canonicalDirectRecipient())
          || (request.resource.data.keys().hasAny(['mentionUid']) &&
              !request.resource.data.keys().hasAny(['replyToId']) &&
              canonicalMentionRecipient())
        )
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(notificationId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(notificationId)).data.authorName == request.resource.data.actorName
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(notificationId)).data.createdAt == request.time;
      allow update: if me(recipientUid)
        && resource.data.read == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if me(recipientUid);
    }

    // Guarda privada de conteúdo temporariamente retirado do fórum.
    // O Worker cria/restaura via credenciais de serviço: nenhum cliente pode
    // colocar mensagens em quarentena nem se conceder poderes do bot.
    match /guardiao_quarantine/{caseId} {
      allow get, list: if isAdmin() || (signedIn() &&
        resource.data.ownerUid == request.auth.uid);
      allow create, delete: if false;
      // Recurso único do autor, sem alterar conteúdo, status ou decisão humana.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'held'
        && !resource.data.keys().hasAny(['appealText','appealedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['appealText','appealedAt'])
        && request.resource.data.keys().hasAll(['appealText','appealedAt'])
        && validText(request.resource.data.appealText, 10, 500)
        && request.resource.data.appealedAt == request.time;
    }

    match /reports/{reportId} {
      // Denúncias são privadas; somente administradores ativos podem consultá-las.
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'replyId', 'reporterUid', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'postId', 'reporterUid', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && validId(request.resource.data.postId)
        // PR #35: somente um registro por denunciante e alvo, inclusive no QA.
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && (request.resource.data.keys().hasAny(['replyId'])
          ? (validId(request.resource.data.replyId)
            && reportId == request.auth.uid + '_reply_' + request.resource.data.postId + '_' + request.resource.data.replyId
            && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/replies/$(request.resource.data.replyId)))
          : reportId == request.auth.uid + '_post_' + request.resource.data.postId)
        && validText(request.resource.data.reason, 5, 300)
        && validTime();
      allow update: if isAdmin()
        && resource.data.get('status', 'pending') == 'pending'
        // Um APK antigo não pode encerrar um caso cuja publicação está
        // retida: restauração/remoção só por decisão atômica do Worker.
        && !(resource.data.get('source', '') == 'guardiao'
          && exists(/databases/$(database)/documents/guardiao_quarantine/$(reportId))
          && get(/databases/$(database)/documents/guardiao_quarantine/$(reportId)).data.status == 'held')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote', 'reviewTarget'])
        && request.resource.data.keys().hasAll(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
        && request.resource.data.status in ['dismissed', 'removed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && validText(request.resource.data.reviewNote, 5, 300)
        && validReviewTarget()
        && (request.resource.data.status != 'removed'
          || reportTargetRemoved());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
