rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Provisionamento e revogação somente pelo Console/Admin SDK autorizado.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    // Public, non-sensitive switch; changes only through Console/Admin SDK.
    match /app_config/opening_video {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
    // Identifica a conta oficial do fundador; publicação somente via SDK/Console.
    // O cliente pode consultar o UID, mas nunca apontar para si mesmo.
    match /app_config/founder {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }
    // Ativação admin-only após publicação e QA. Negado por padrão.
    match /app_config/engagement {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if me(uid);
      allow list, create, update, delete: if false;
    }
    // BEGIN GENERATED REACTION EMOJI ALLOWLIST (Unicode 17.0, tools/emoji/generate.py)
    function validReactionKind(kind) {
      return kind is string && (kind in ['heart', 'prayer', 'light']
        || (kind.size() <= 32 && (
          kind.matches('(?:😀|😃|😄|😁|😆|😅|🤣|😂|🙂(?:‍(?:↔️|↕️))?|🙃|🫠|😉|😊|😇|🥰|😍|🤩|😘|😗|☺️|😚|😙|🥲|😋|😛|😜|🤪|😝|🤑|🤗|🤭|🫢|🫣|🤫|🤔|🫡|🤐|🤨|😐|😑|😶(?:‍🌫️)?|🫥|😏|😒|🙄|😬|😮(?:‍💨)?|🤥|🫨|😌|😔|😪|🤤|😴|🫩|😷|🤒|🤕|🤢|🤮|🤧|🥵|🥶|🥴|😵(?:‍💫)?|🤯|🤠|🥳|🥸|😎|🤓|🧐|😕|🫤|😟|🙁|☹️|😯|😲|😳|🫪|🥺|🥹|😦|😧|😨|😰|😥|😢|😭|😱|😖|😣|😞|😓|😩|😫|🥱|😤|😡|😠|🤬|😈|👿|💀|☠️|💩|🤡|👹|👺|👻|👽|👾|🤖|😺|😸|😹|😻|😼|😽|🙀|😿|😾|🙈|🙉|🙊|💌|💘|💝|💖|💗|💓|💞|💕|💟|❣️|💔|❤️(?:‍(?:🔥|🩹))?|🩷|🧡|💛|💚|💙|🩵|💜|🤎|🖤|🩶|🤍|💋|💯|💢|🫯|💥|💫|💦|💨|🕳️|💬|👁️‍🗨️|🗨️|🗯️|💭|💤|👋(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤚(?:(?:🏻|🏼|🏽|🏾|🏿))?|🖐(?:️|🏻|🏼|🏽|🏾|🏿)|✋(?:(?:🏻|🏼|🏽|🏾|🏿))?|🖖(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫱(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫲(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫳(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫴(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫷(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫸(?:(?:🏻|🏼|🏽|🏾|🏿))?|👌(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤌(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤏(?:(?:🏻|🏼|🏽|🏾|🏿))?|✌(?:️|🏻|🏼|🏽|🏾|🏿)|🤞(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫰(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤟(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤘(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤙(?:(?:🏻|🏼|🏽|🏾|🏿))?|👈(?:(?:🏻|🏼|🏽|🏾|🏿))?|👉(?:(?:🏻|🏼|🏽|🏾|🏿))?|👆(?:(?:🏻|🏼|🏽|🏾|🏿))?|🖕(?:(?:🏻|🏼|🏽|🏾|🏿))?|👇(?:(?:🏻|🏼|🏽|🏾|🏿))?|☝(?:️|🏻|🏼|🏽|🏾|🏿)|🫵(?:(?:🏻|🏼|🏽|🏾|🏿))?|👍(?:(?:🏻|🏼|🏽|🏾|🏿))?|👎(?:(?:🏻|🏼|🏽|🏾|🏿))?|✊(?:(?:🏻|🏼|🏽|🏾|🏿))?|👊(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤛(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤜(?:(?:🏻|🏼|🏽|🏾|🏿))?|👏(?:(?:🏻|🏼|🏽|🏾|🏿))?|🙌(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫶(?:(?:🏻|🏼|🏽|🏾|🏿))?|👐(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤲(?:🏻)?)')
          || kind.matches('(?:🤲(?:🏼|🏽|🏾|🏿)|🤝(?:(?:🏻|🏼|🏽|🏾|🏿))?|🫱(?:🏻‍🫲(?:🏼|🏽|🏾|🏿)|🏼‍🫲(?:🏻|🏽|🏾|🏿)|🏽‍🫲(?:🏻|🏼|🏾|🏿)|🏾‍🫲(?:🏻|🏼|🏽|🏿)|🏿‍🫲(?:🏻|🏼|🏽|🏾))|🙏(?:(?:🏻|🏼|🏽|🏾|🏿))?|✍(?:️|🏻|🏼|🏽|🏾|🏿)|💅(?:(?:🏻|🏼|🏽|🏾|🏿))?|🤳(?:(?:🏻|🏼|🏽|🏾|🏿))?|💪(?:(?:🏻|🏼|🏽|🏾|🏿))?|🦾|🦿|🦵(?:(?:🏻|🏼|🏽|🏾|🏿))?|🦶(?:(?:🏻|🏼|🏽|🏾|🏿))?|👂(?:(?:🏻|🏼|🏽|🏾|🏿))?|🦻(?:(?:🏻|🏼|🏽|🏾|🏿))?|👃(?:(?:🏻|🏼|🏽|🏾|🏿))?|🧠|🫀|🫁|🦷|🦴|👀|👁️|👅|👄|🫦|👶(?:(?:🏻|🏼|🏽|🏾|🏿))?|🧒(?:(?:🏻|🏼|🏽|🏾|🏿))?|👦(?:(?:🏻|🏼|🏽|🏾|🏿))?|👧(?:(?:🏻|🏼|🏽|🏾|🏿))?|🧑(?:(?:🏻(?:‍🦰)?|🏼(?:‍🦰)?|🏽(?:‍🦰)?|🏾(?:‍🦰)?|🏿(?:‍🦰)?|‍🦰))?|👱(?:(?:🏻|🏼|🏽|🏾|🏿))?|👨(?:(?:🏻(?:‍(?:🦰|🦱|🦳|🦲))?|🏼(?:‍(?:🦰|🦱|🦳|🦲))?|🏽(?:‍(?:🦰|🦱|🦳|🦲))?|🏾(?:‍(?:🦰|🦱|🦳|🦲))?|🏿(?:‍(?:🦰|🦱|🦳|🦲))?|‍(?:🦰|🦱|🦳|🦲)))?|🧔(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|👩(?:(?:🏻(?:‍🦰)?|🏼(?:‍🦰)?|🏽(?:‍🦰)?|🏾(?:‍🦰)?|🏿(?:‍🦰)?|‍(?:🦰|🦱)))?)')
          || kind.matches('(?:👩(?:🏻‍(?:🦱|🦳|🦲)|🏼‍(?:🦱|🦳|🦲)|🏽‍(?:🦱|🦳|🦲)|🏾‍(?:🦱|🦳|🦲)|🏿‍(?:🦱|🦳|🦲)|‍(?:🦳|🦲))|🧑(?:‍(?:🦱|🦳|🦲)|🏻‍(?:🦱|🦳|🦲)|🏼‍(?:🦱|🦳|🦲)|🏽‍(?:🦱|🦳|🦲)|🏾‍(?:🦱|🦳|🦲)|🏿‍(?:🦱|🦳|🦲))|👱(?:‍(?:♀️|♂️)|🏻‍(?:♀️|♂️)|🏼‍(?:♀️|♂️)|🏽‍(?:♀️|♂️)|🏾‍(?:♀️|♂️)|🏿‍(?:♀️|♂️))|🧓(?:(?:🏻|🏼|🏽|🏾|🏿))?|👴(?:(?:🏻|🏼|🏽|🏾|🏿))?|👵(?:(?:🏻|🏼|🏽|🏾|🏿))?|🙍(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🙎(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🙅(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🙆(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|💁)')
          || kind.matches('(?:💁(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️))|🙋(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🧏(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🙇(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🤦(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🤷(?:(?:🏻(?:‍(?:♂️|♀️))?|🏼(?:‍(?:♂️|♀️))?|🏽(?:‍(?:♂️|♀️))?|🏾(?:‍(?:♂️|♀️))?|🏿(?:‍(?:♂️|♀️))?|‍(?:♂️|♀️)))?|🧑(?:‍⚕️|🏻‍⚕️|🏼‍⚕️|🏽‍⚕️|🏾‍⚕️|🏿‍⚕️)|👨(?:‍⚕️|🏻‍⚕️|🏼‍⚕️|🏽‍⚕️|🏾‍⚕️|🏿‍⚕️)|👩‍⚕️)')
