rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PERFIL QA: candidato OFFLINE, nunca publicado automaticamente.
    // Sem fallbacks para flags inexistentes; Auth do projeto QA exclusivamente.
    function signedInWithEmail() {
      return request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 3;
    }
    function verified() {
      return signedInWithEmail()
        && request.auth.token.get('email_verified', false) == true;
    }
    function owner(uid) {
      return signedInWithEmail() && request.auth.uid == uid;
    }
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 35;
    }
    function validBio(bio) {
      return bio is string && bio.size() <= 180;
    }

    // Cadastro mínimo do próprio titular. Nenhuma enumeração de perfis privados.
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'createdAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      // Edição exige e-mail confirmado e projeção pública sincronizada no
      // mesmo batch/transaction quando o opt-in público já existe.
      allow update: if owner(uid) && verified()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio'])
        && validName(request.resource.data.displayName)
        && validBio(request.resource.data.get('bio', ''))
        && (!exists(/databases/$(database)/documents/public_profiles/$(uid))
          || (getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.displayName == request.resource.data.displayName
            && getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.bio == request.resource.data.get('bio', '')
            && getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.updatedAt == request.time));
      allow delete: if false;
    }

    // Apresentação voluntária: não expõe /profiles a outros membros.
    match /public_profiles/{uid} {
      allow get: if verified();
      allow list: if false;
      allow create, update: if owner(uid) && verified()
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && validName(request.resource.data.displayName)
        && validBio(request.resource.data.bio)
        && request.resource.data.displayName ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.displayName
        && request.resource.data.bio ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.get('bio', '')
        && request.resource.data.joinedAt ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid) && verified();
    }

    // O histórico "Minhas discussões" usa UID + createdAt ou ID, com limit(20).
    // Posts são comunitários, não privados por UID. Neste piloto somente
    // documentos SINTÉTICOS provisionados sob autorização administrativa;
    // clientes NÃO publicam, editam nem apagam posts.
    match /posts/{postId} {
      allow get: if verified();
      allow list: if verified()
        && request.query.limit != null
        && request.query.limit <= 20;
      allow create, update, delete: if false;
    }

    // Exibir foto/selo público de QA, sem permitir atribuir identidade
    // religiosa ou publicar fotos a partir do APK.
    match /badges/{uid} {
      allow get: if verified();
      allow list, create, update, delete: if false;
    }
    match /profile_photos/{uid} {
      allow get: if verified();
      allow list, create, update, delete: if false;
    }

    // Metadado de política consultável no cadastro, imutável pelo cliente.
    match /app_config/email_verification {
      allow get: if signedInWithEmail();
      allow list, create, update, delete: if false;
    }

    // Guardião, chats, notificações, denúncias, consentimentos, preferências
    // sensíveis, Admin, Storage e todas as demais rotas ficam FECHADOS.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
