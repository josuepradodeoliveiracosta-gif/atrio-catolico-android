rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Candidato EXCLUSIVAMENTE offline para o piloto Perfil QA.
    // Sem cadastro, conteudo comunitario, chat ou dados reais.
    function signedInWithEmail() {
      return request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 3;
    }
    function verified() {
      return signedInWithEmail()
        && request.auth.token.get('email_verified', false) == true;
    }
    function verifiedOwner(uid) {
      return verified() && request.auth.uid == uid;
    }
    function ownPost() {
      return verified() && resource.data.uid == request.auth.uid;
    }
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 35;
    }
    function validBio(bio) {
      return bio is string && bio.size() <= 180;
    }

    // Login de conta QA existente; perfis sintéticos são provisionados
    // fora do aplicativo e somente após autorização própria do fundador.
    match /profiles/{uid} {
      allow get: if verifiedOwner(uid);
      allow list, create, delete: if false;
      allow update: if verifiedOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio'])
        && validName(request.resource.data.displayName)
        && validBio(request.resource.data.get('bio', ''))
        // Se ja existe opt-in publico, a transacao deve atualizar a
        // mesma projecao e nao pode recria-la apos revogacao.
        && (!exists(/databases/$(database)/documents/public_profiles/$(uid))
          || (getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.displayName == request.resource.data.displayName
            && getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.bio == request.resource.data.get('bio', '')
            && getAfter(/databases/$(database)/documents/public_profiles/$(uid))
                .data.updatedAt == request.time));
    }

    // A transacao Android consulta SOMENTE a projecao propria.
    // Opt-in novo, enumeracao publica e exclusao nao fazem parte do piloto.
    match /public_profiles/{uid} {
      allow get: if verifiedOwner(uid);
      allow list, create, delete: if false;
      allow update: if verifiedOwner(uid)
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'bio', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && validBio(request.resource.data.bio)
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.joinedAt ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.createdAt
        && request.resource.data.displayName ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.displayName
        && request.resource.data.bio ==
          getAfter(/databases/$(database)/documents/profiles/$(uid)).data.get('bio', '')
        // getAfter isolado compara estados, mas nao demonstra que
        // profiles/{uid} foi alterado no mesmo batch/transaction.
        // Exigir diferenca real nos campos editaveis fecha o bypass
        // de "updatedAt-only" em public_profiles.
        && getAfter(/databases/$(database)/documents/profiles/$(uid))
          .data.diff(get(/databases/$(database)/documents/profiles/$(uid)).data)
          .affectedKeys().hasAny(['displayName', 'bio'])
        && request.resource.data.updatedAt == request.time;
    }

    // Firestore Rules NÃO filtram resultados: o cliente deve enviar
    // where('uid', '==', auth.uid) E limit(20) inclusive no legado por ID.
    match /posts/{postId} {
      allow get: if ownPost();
      allow list: if ownPost()
        && request.query.limit != null
        && request.query.limit <= 20;
      // Publicacoes do titular apenas para leitura. Sem UGC no piloto.
      allow create, update, delete: if false;
    }

    // Selos, fotos, app_config, chats, notificacoes, dados religiosos,
    // replies e todas as outras colecoes permanecem FECHADAS.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
